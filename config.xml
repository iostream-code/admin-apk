<?xml version='1.0' encoding='utf-8'?>
<widget android-versionCode="1" id="com.koperindo.admin" ios-CFBundleVersion="1.0.0" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Admin</name>
    <description>Aplikasi Admin Koperindo -- konfirmasi &amp; monitoring Point Sales/Produksi/Admin/SJ, absensi, data gaji, dan transaksi kas. Migrasi dari admin-finance-apk.</description>
    <author email="dev@example.com" href="https://example.com">Tim Dev</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="Orientation" value="portrait" />
    <preference name="android-minSdkVersion" value="24" />
    <!-- [FIX 2026-09-09, ditemukan saat upgrade cordova-plugin-firebasex ke
         v20 utk perbaiki error "periksa kenapa eror muncul"] cordova-android
         15 TIDAK punya fallback default utk compileSdkVersion kalau
         preference ini kosong, hasilnya `compileSdkVersion
         cordovaConfig.COMPILE_SDK_VERSION` di app/build.gradle jadi
         `compileSdkVersion null`, baru kelihatan gagalnya SETELAH error
         GoogleServicesPlugin (root cause error aslinya) diperbaiki:
         Gradle berhenti di kegagalan config PERTAMA yang ditemui, jadi bug
         ini sebelumnya "tersembunyi" di baliknya. Nilai 36 disamakan dgn
         SDK_VERSION (target) yang sudah jadi default cordova-android 15 ini. -->
    <preference name="android-compileSdkVersion" value="36" />
    <preference name="AndroidXEnabled" value="true" />
    <platform name="android">
        <allow-intent href="market:*" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
        <config-file parent="/manifest" target="AndroidManifest.xml">
            <uses-permission android:name="android.permission.INTERNET" />
        </config-file>
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/icon.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#FFFFFF" />
        <icon density="ldpi" src="resources/android/icon/drawable-ldpi-icon.png" />
        <icon density="mdpi" src="resources/android/icon/drawable-mdpi-icon.png" />
        <icon density="hdpi" src="resources/android/icon/drawable-hdpi-icon.png" />
        <icon density="xhdpi" src="resources/android/icon/drawable-xhdpi-icon.png" />
        <icon density="xxhdpi" src="resources/android/icon/drawable-xxhdpi-icon.png" />
        <icon density="xxxhdpi" src="resources/android/icon/drawable-xxxhdpi-icon.png" />
        <resource-file src="resources/values/colors.xml" target="/app/src/main/res/values/colors.xml" />
        <!-- Adaptive icon (mipmap-*-v26, Android 8+) SENGAJA tidak dipakai, sama alasan
             persis dgn ekspedisi-apk/inventory-apk/config.xml: cordova-android 15.1.0
             tidak mempertahankan file adaptive-icon (foreground/background) walau
             ditaruh manual, kehapus tiap `cordova prepare`/build. Icon flat
             (mipmap-*/ic_launcher.png, lewat icon density/src di atas) sudah cukup
             dan terverifikasi jalan di app-app sibling tsb. -->
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />
    <plugin name="cordova-plugin-device" spec="^2.1.0" />
    <plugin name="cordova-plugin-statusbar" spec="^3.0.0" />
    <plugin name="cordova-plugin-splashscreen" spec="^6.0.2" />
    <!-- TODO menyusul saat fitur terkait dimigrasikan dari admin-finance-apk:
         cordova-plugin-camera (foto konfirmasi), cordova-plugin-file +
         file-opener2 (cetak/simpan PDF, pola sama inventory-apk/purchase-finance-apk).
         Belum ditambah di sini supaya scaffold awal ini tetap minimal sampai
         halaman yang membutuhkannya benar-benar diporting, lihat README.md
         "Status Migrasi". -->
    <!-- [DITAMBAHKAN 2026-09-07 atas permintaan user, "pastikan firebasenya
         juga sudah terinstall"] cordova-plugin-firebasex, integrasi push
         notification (lib/firebaseNotif.js). [UPGRADE 2026-09-09, perbaikan
         build "Failed to apply plugin class GoogleServicesPlugin" saat
         install APK] v16.5.0 (monolitik) diganti v20.0.2 (wrapper modular,
         lihat MIGRATION.md paket ini): v16.5.0 memasang google-services
         lewat hook afterEvaluate lama yang TIDAK kompatibel dgn
         cordova-android 15/AGP 8.10 (Variant API baru). Wrapper v20 tetap
         mengekspos global JS `FirebasePlugin.*` yang sama (TIDAK ADA
         perubahan kode di lib/firebaseNotif.js). Sub-plugin `crashlytics`
         SENGAJA TIDAK dipasang (dibuang dari wrapper): fiturnya tidak
         pernah dipakai di app ini (grep `logError`/`Crashlytics` di src/
         nihil) & versi yang otomatis ke-resolve wrapper (2.0.2) py bug
         packaging Gradle sendiri (`Plugin with id
         'com.google.firebase.crashlytics' not found`, classpath-nya tidak
         pernah ditambahkan). Variable plugin (versi SDK per servis dst)
         SEKARANG dikelola penuh oleh package.json > cordova.plugins
         (otomatis diisi cordova plugin add dari default plugin.xml
         masing2 sub-plugin), TIDAK diduplikasi manual di sini lagi,
         cukup 2 variable perilaku (bukan sekadar versi SDK) yang eksplisit
         di-set saat install: FIREBASE_ANALYTICS_COLLECTION_ENABLED &
         FIREBASE_FCM_AUTOINIT_ENABLED (nama baru dari
         FIREBASE_MESSAGING_AUTO_INIT_ENABLED lama), keduanya "true" sama
         seperti sebelumnya. -->
    <plugin name="cordova-plugin-firebasex" spec="^20.0.2" />
</widget>
