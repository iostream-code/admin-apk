{
  "name": "admin-apk",
  "version": "1.0.0",
  "description": "Aplikasi Admin -- konfirmasi & monitoring Point Sales/Produksi/Admin/SJ, absensi, data gaji, transaksi kas Koperindo. Migrasi dari admin-finance-apk, berbasis Cordova + jQuery + Tailwind + Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cordova:prepare": "npm run build && node fix-platform-type.cjs && cordova prepare",
    "cordova:android": "npm run build && node fix-platform-type.cjs && cordova run android",
    "cordova:ios": "npm run build && node fix-platform-type.cjs && cordova run ios",
    "fix:platforms": "node fix-platform-type.cjs",
    "version:patch": "node bump-version.cjs patch",
    "version:minor": "node bump-version.cjs minor",
    "version:major": "node bump-version.cjs major",
    "version:custom": "node bump-version.cjs"
  },
  "dependencies": {
    "cordova-plugin-firebasex": "20.0.2",
    "cordova-plugin-firebasex-inappmessaging": "2.0.1",
    "cordova-plugin-firebasex-messaging": "2.0.3",
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "cordova-android": "^15.1.0",
    "cordova-browser": "^7.0.0",
    "cordova-plugin-device": "^2.1.0",
    "cordova-plugin-splashscreen": "^6.0.2",
    "cordova-plugin-statusbar": "^3.0.0",
    "cordova-plugin-whitelist": "^1.3.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-whitelist": {},
      "cordova-plugin-device": {},
      "cordova-plugin-statusbar": {},
      "cordova-plugin-splashscreen": {},
      "cordova-plugin-firebasex": {
        "FIREBASE_ANALYTICS_COLLECTION_ENABLED": "true",
        "FIREBASE_FCM_AUTOINIT_ENABLED": "true",
        "ANDROID_FIREBASE_CORE_VERSION": "21.1.1",
        "ANDROID_FIREBASE_INSTALLATIONS_VERSION": "19.1.0",
        "ANDROID_GSON_VERSION": "2.14.0",
        "IOS_FIREBASE_SDK_VERSION": "12.14.0",
        "IOS_FIREBASE_SDK_BETA_VERSION": "12.14.0-beta",
        "IOS_STRIP_DEBUG": "false",
        "ANDROID_FIREBASE_ANALYTICS_VERSION": "23.0.0",
        "ANDROID_PLAY_SERVICES_TAGMANAGER_VERSION": "18.3.0",
        "IOS_GOOGLE_TAG_MANAGER_VERSION": "9.1.0",
        "FIREBASE_ANALYTICS_WITHOUT_ADS": "false",
        "GOOGLE_ANALYTICS_ADID_COLLECTION_ENABLED": "true",
        "GOOGLE_ANALYTICS_DEFAULT_ALLOW_ANALYTICS_STORAGE": "true",
        "GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_STORAGE": "true",
        "GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_USER_DATA": "true",
        "GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_PERSONALIZATION_SIGNALS": "true",
