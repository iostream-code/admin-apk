        "ANDROID_FIREBASE_PERF_GRADLE_PLUGIN_VERSION": "2.0.2",
        "ANDROID_FIREBASE_FIRESTORE_VERSION": "26.3.0",
        "ANDROID_GRPC_OKHTTP": "1.81.0",
        "IOS_USE_PRECOMPILED_FIRESTORE_POD": "false",
        "ANDROID_FIREBASE_FUNCTIONS_VERSION": "22.1.1",
        "ANDROID_FIREBASE_CONFIG_VERSION": "23.1.0",
        "ANDROID_FIREBASE_INAPPMESSAGING_VERSION": "22.0.3"
